---
import Feature from "@/content/communities.json";
---

<div class="mt-24">
  <h2 class="text-center lg:text-5xl font-bold lg:tracking-tight"> 参加するコミュニティ</h2>
</div>
<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    Feature.map((item) => (
      <div class="flex flex-col items-start">
        <h3 class="font-semibold text-xl">{item.name}</h3>
        {item.location && (
          <p class="text-indigo-500 font-medium text-sm mt-1">{item.location}</p>
        )}
        <p class="text-slate-500 mt-3 leading-relaxed">{item.description}</p>
        {item.link && (
          <a href={item.link} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 font-medium text-indigo-600 hover:text-indigo-800 hover:underline transition-colors">
            詳細・参加登録 →
          </a>
        )}
      </div>
    ))
  }
</div>

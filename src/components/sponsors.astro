---
import { Image } from "astro:assets";
// ※パスは現在のファイル位置に合わせて適宜調整してください
import wingarchLogo from "../assets/sponsors/wingarch1st.svg";
import mitsubishiLogo from "../assets/sponsors/mitsubishi.png";
import kagLogo from "../assets/sponsors/kag.png";

const sponsors = [
  {
    tier: "Platinum",
    companies: [],
    sizeClass: "w-64 h-32 md:w-80 md:h-40 text-xl md:text-2xl rounded-md",
  },
  {
    tier: "Gold",
    companies: [],
    sizeClass: "w-48 h-24 md:w-64 md:h-32 text-lg md:text-xl rounded-md",
  },
  {
    tier: "Silver",
    companies: [
      { name: "三菱電機", logo: mitsubishiLogo, url: "https://www.mitsubishielectric.co.jp/serendie/" },
    ],
    sizeClass: "w-36 h-16 md:w-48 md:h-24 text-base md:text-lg rounded-md",
  },
  {
    tier: "Bronze",
    companies: [
      { name: "ウイングアーク１ｓｔ", logo: wingarchLogo, url: "https://corp.wingarc.com/recruit/index.html" },
      { name: "KAG", logo: kagLogo, url: "https://kddi-agile.com" }
    ],
    sizeClass: "w-28 h-12 md:w-36 md:h-16 text-sm md:text-base rounded-md",
  },
  {
    tier: "個人",
    companies: [],
    sizeClass: "w-20 h-20 md:w-24 md:h-24 text-xs md:text-sm rounded-full",
  },
];
---

<div class="mt-24">
  <h2 class="text-center lg:text-5xl font-bold lg:tracking-tight">スポンサー</h2>
  <div class="flex flex-col gap-16 mt-16">
    {
      sponsors.filter((sponsor) => sponsor.companies.length > 0).map((sponsor) => (
        <div>
          <h3 class="text-center font-semibold text-slate-600 mb-6">
            {sponsor.tier}
          </h3>
          <div class="flex gap-4 md:gap-6 items-center justify-center flex-wrap">
            {/* 決定したスポンサーのロゴを表示 */}
            {sponsor.companies.map((company) => (
              company.url ? (
                <a href={company.url} target="_blank" rel="noopener noreferrer" class={`bg-white flex items-center justify-center shadow-sm border border-slate-200 p-2 hover:shadow-md transition-shadow hover:-translate-y-0.5 transform duration-200 ${sponsor.sizeClass}`}>
                  <Image src={company.logo} alt={company.name} class="w-full h-full object-contain" />
                </a>
              ) : (
                <div class={`bg-white flex items-center justify-center shadow-sm border border-slate-200 p-2 ${sponsor.sizeClass}`}>
                  <Image src={company.logo} alt={company.name} class="w-full h-full object-contain" />
                </div>
              )
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">実行委員会について</Fragment>
      <Fragment slot="desc">スクラム祭りを作り上げるメンバーたちです。</Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-4xl mt-12 mb-24 bg-slate-50 p-8 rounded-lg shadow-sm border border-slate-100">
      <h3 class="font-bold text-xl text-gray-800 mb-4">スクラム祭り実行委員会 (敬称略)</h3>
      <p class="text-lg leading-relaxed text-slate-600">
        松野哲(aki.m)、山下友輔(やまずん)、内田雄介、兼島恭平、平井翔一郎、吉野正義、松下純、竹内賢司、松崎一孝
      </p>
    </div>
  </Container>
</Layout>
